@model CreatePostDto
@{
    ViewData["Title"] = "New post";
}

<div class="aca-feed">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
        <h1 class="h4 fw-semibold mb-0">Create a post</h1>
        <a class="small text-decoration-none" asp-action="Index">Back to feed</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label">What's on your mind?</label>
                    <textarea asp-for="Content" class="form-control" rows="6" maxlength="5000" required
                              placeholder="Share an update with the community…"></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                    <div class="form-text">Up to 5,000 characters.</div>
                </div>

                <div class="mb-3">
                    <label for="images" class="form-label">
                        Images <span class="aca-muted fw-normal">(optional)</span>
                    </label>
                    <input type="file" id="images" name="images" class="form-control"
                           multiple accept="image/jpeg,image/png,image/webp" />
                    <div class="form-text">Up to 4 images. JPEG, PNG, or WebP, max 5 MB each.</div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Publish post</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
