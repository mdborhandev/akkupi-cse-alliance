@model CreatePostDto
@{
    ViewData["Title"] = "New post";
}

<div class="aca-feed">
    <a class="aca-back" asp-action="Index">
        <partial name="_Icon" model="@("chevron-left")" /> Back to feed
    </a>

    <div class="aca-page-head">
        <div>
            <span class="aca-eyebrow"><partial name="_Icon" model="@("pen")" /> New post</span>
            <h1>Share something</h1>
            <p class="aca-page-sub">An update, a question, a memory — every batch is listening.</p>
        </div>
    </div>

    <form method="post" asp-action="Create" enctype="multipart/form-data" class="aca-compose-card">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <label asp-for="Content" class="form-label">What's on your mind?</label>
        <textarea asp-for="Content" class="form-control aca-textarea" rows="7" maxlength="5000" required
                  placeholder="Write your post…"></textarea>
        <span asp-validation-for="Content" class="text-danger small"></span>
        <div class="form-text">Up to 5,000 characters.</div>

        <div class="aca-compose-foot">
            <div class="aca-upload">
                <label for="images" class="aca-upload-label">
                    <partial name="_Icon" model="@("image")" /> Add photos
                </label>
                <input type="file" id="images" name="images" class="form-control" multiple
                       accept="image/jpeg,image/png,image/webp" />
                <div class="form-text">Up to 4 images · JPEG, PNG or WebP · max 5 MB each</div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Publish post</button>
            </div>
        </div>
    </form>
</div>
