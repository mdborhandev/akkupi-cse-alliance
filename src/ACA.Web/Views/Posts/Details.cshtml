@using System.Security.Claims
@model PostDto
@{
    ViewData["Title"] = "Post";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var currentUserId = Guid.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var parsedId)
        ? (Guid?)parsedId
        : null;
    var canManage = isSignedIn && (currentUserId == Model.AuthorId || User.IsInRole("Admin"));
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var reactionTypes = new[] { ReactionType.Like, ReactionType.Love, ReactionType.Support };
}

<div class="aca-feed">
    <a class="aca-back" asp-action="Index">
        <partial name="_Icon" model="@("chevron-left")" /> Back to feed
    </a>

    <article class="aca-post aca-post--detail">
        <header class="aca-post-head">
            @if (!string.IsNullOrWhiteSpace(Model.AuthorPhotoUrl))
            {
                <img src="@Model.AuthorPhotoUrl" alt="" class="aca-avatar" />
            }
            else
            {
                <span class="aca-avatar" aria-hidden="true">@Initial(Model.AuthorName)</span>
            }
            <div class="aca-post-who">
                <div class="aca-post-name">@DisplayName(Model.AuthorName)</div>
                <div class="aca-post-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.BatchName))
                    {
                        <span class="aca-chip">@Model.BatchName</span>
                    }
                    <span class="aca-chip @(Model.MemberType == MemberType.Alumni ? "aca-chip--alumni" : "aca-chip--student")">
                        @(Model.MemberType == MemberType.Alumni ? "Alumni" : "Student")
                    </span>
                    <span aria-hidden="true">·</span>
                    <span title="@Model.CreatedAtUtc.ToString("u")">@TimeAgo(Model.CreatedAtUtc)</span>
                    @if (Model.IsEdited)
                    {
                        <span>· edited</span>
                    }
                </div>
            </div>

            @if (canManage)
            {
                <div class="aca-post-tools">
                    <a class="aca-icon-btn" asp-action="Edit" asp-route-id="@Model.Id" title="Edit post" aria-label="Edit post">
                        <partial name="_Icon" model="@("pen")" />
                    </a>
                    <form method="post" asp-action="Delete" asp-route-id="@Model.Id"
                          onsubmit="return confirm('Delete this post? This cannot be undone.');">
                        <button type="submit" class="aca-icon-btn aca-icon-btn--danger" title="Delete post" aria-label="Delete post">
                            <partial name="_Icon" model="@("trash")" />
                        </button>
                    </form>
                </div>
            }
        </header>

        <div class="aca-post-content">@Model.Content</div>

        @if (Model.Images.Count > 0)
        {
            <div class="aca-post-media" data-count="@Model.Images.Count">
                @foreach (var image in Model.Images)
                {
                    <a href="@image.Url" target="_blank" rel="noopener noreferrer" class="aca-media-item">
                        <img src="@image.Url" alt="Image attached to a post by @DisplayName(Model.AuthorName)" loading="lazy" />
                    </a>
                }
            </div>
        }

        <footer class="aca-post-actions aca-post-actions--wrap">
            @foreach (var type in reactionTypes)
            {
                <form method="post" asp-controller="Reactions" asp-action="Toggle" class="d-inline">
                    <input type="hidden" name="postId" value="@Model.Id" />
                    <input type="hidden" name="type" value="@((int)type)" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit"
                            class="aca-reaction @(Model.MyReaction == type ? "is-active" : string.Empty)"
                            aria-pressed="@(Model.MyReaction == type ? "true" : "false")"
                            title="@ReactionLabel(type)">
                        <partial name="_Icon" model="@(type switch { ReactionType.Like => "heart", ReactionType.Love => "spark", _ => "users" })" />
                        <span>@ReactionLabel(type)</span>
                    </button>
                </form>
            }

            <span class="aca-action aca-action--static" aria-label="@Model.CommentCount comments">
                <partial name="_Icon" model="@("message")" /> @Model.CommentCount
            </span>

            @if (isSignedIn)
            {
                <a class="aca-action aca-action--end" asp-controller="Reports" asp-action="Create"
                   asp-route-postId="@Model.Id" asp-route-returnUrl="@returnUrl">
                    <partial name="_Icon" model="@("flag")" /> Report
                </a>
            }
        </footer>
    </article>

    <partial name="_CommentsSection" model="Model.Id" />
</div>

@functions {
    private static string DisplayName(string? name)
    {
        var trimmed = (name ?? string.Empty).Trim();
        return trimmed.Length == 0 ? "Member" : trimmed;
    }

    private static string Initial(string? name)
    {
        var trimmed = (name ?? string.Empty).Trim();
        return trimmed.Length == 0 ? "?" : trimmed[..1].ToUpperInvariant();
    }

    private static string ReactionLabel(ReactionType type) => type switch
    {
        ReactionType.Like => "Like",
        ReactionType.Love => "Love",
        ReactionType.Support => "Support",
        _ => type.ToString()
    };

    private static string TimeAgo(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalSeconds < 60)
        {
            return "just now";
        }

        if (span.TotalMinutes < 60)
        {
            return $"{(int)span.TotalMinutes}m ago";
        }

        if (span.TotalHours < 24)
        {
            return $"{(int)span.TotalHours}h ago";
        }

        if (span.TotalDays < 7)
        {
            return $"{(int)span.TotalDays}d ago";
        }

        if (span.TotalDays < 30)
        {
            return $"{(int)(span.TotalDays / 7)}w ago";
        }

        return utc.ToLocalTime().ToString("MMM d, yyyy");
    }
}
