@model PagedResult<PostDto>
@{
    ViewData["Title"] = "Feed";
    var batchId = (Guid?)ViewData["BatchId"];
    var batchQuery = batchId.HasValue ? $"&batchId={batchId.Value}" : string.Empty;
    var feedUrl = Url.Action("Index", "Posts") ?? "/Posts";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var accountName = User.Identity?.Name ?? string.Empty;
    var accountSource = accountName.Contains('@') ? accountName.Split('@')[0] : accountName;
    var accountInitial = accountSource.Length == 0 ? "?" : accountSource[..1].ToUpperInvariant();
}

<div class="aca-layout">
    <div class="aca-feed">
        <div class="aca-page-head">
            <div>
                <span class="aca-eyebrow"><partial name="_Icon" model="@("spark")" /> Community</span>
                <h1>Feed</h1>
                <p class="aca-page-sub">Latest posts from students and alumni across every batch.</p>
            </div>
            <div class="d-flex gap-2">
                @if (isSignedIn)
                {
                    <a class="btn btn-primary" asp-action="Create">
                        <partial name="_Icon" model="@("plus")" /> Share something
                    </a>
                }
                else
                {
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Join the community</a>
                }
            </div>
        </div>

        @if (isSignedIn)
        {
            <div class="aca-composer">
                <span class="aca-avatar" aria-hidden="true">@accountInitial</span>
                <a class="aca-composer-input flex-grow-1" asp-action="Create">Share something with the community…</a>
                <div class="aca-composer-actions">
                    <a class="aca-icon-btn" asp-action="Create" title="Share a photo post" aria-label="Share a photo post">
                        <partial name="_Icon" model="@("image")" />
                    </a>
                </div>
            </div>
        }

        @if (Model.Items.Count == 0)
        {
            <div class="aca-empty">
                <div class="aca-empty-icon"><partial name="_Icon" model="@("spark")" /></div>
                <p class="mb-1 fw-semibold text-body">No posts yet</p>
                <p class="mb-3 small">Be the first to share something with the community.</p>
                @if (isSignedIn)
                {
                    <a class="btn btn-sm btn-primary" asp-action="Create">Write the first post</a>
                }
            </div>
        }
        else
        {
            @foreach (var post in Model.Items)
            {
                <article class="aca-post">
                    <header class="aca-post-head">
                        @if (!string.IsNullOrWhiteSpace(post.AuthorPhotoUrl))
                        {
                            <img src="@post.AuthorPhotoUrl" alt="" class="aca-avatar" loading="lazy" />
                        }
                        else
                        {
                            <span class="aca-avatar" aria-hidden="true">@Initial(post.AuthorName)</span>
                        }
                        <div class="aca-post-who">
                            <div class="aca-post-name">@DisplayName(post.AuthorName)</div>
                            <div class="aca-post-meta">
                                @if (!string.IsNullOrWhiteSpace(post.BatchName))
                                {
                                    <span class="aca-chip">@post.BatchName</span>
                                }
                                <span class="aca-chip @(post.MemberType == MemberType.Alumni ? "aca-chip--alumni" : "aca-chip--student")">
                                    @(post.MemberType == MemberType.Alumni ? "Alumni" : "Student")
                                </span>
                                <span aria-hidden="true">·</span>
                                <span title="@post.CreatedAtUtc.ToString("u")">@TimeAgo(post.CreatedAtUtc)</span>
                                @if (post.IsEdited)
                                {
                                    <span>· edited</span>
                                }
                            </div>
                        </div>
                    </header>

                    <div class="aca-post-content">@post.Content</div>

                    @if (post.Images.Count > 0)
                    {
                        <div class="aca-post-media" data-count="@post.Images.Count">
                            @foreach (var image in post.Images)
                            {
                                <a asp-action="Details" asp-route-id="@post.Id" class="aca-media-item">
                                    <img src="@image.Url" alt="Image attached to a post by @DisplayName(post.AuthorName)"
                                         loading="lazy" />
                                </a>
                            }
                        </div>
                    }

                    <footer class="aca-post-actions">
                        <a class="aca-action" asp-action="Details" asp-route-id="@post.Id" aria-label="@post.ReactionCount reactions">
                            <partial name="_Icon" model="@("heart")" />
                            <span>@post.ReactionCount</span>
                        </a>
                        <a class="aca-action" asp-action="Details" asp-route-id="@post.Id" aria-label="@post.CommentCount comments">
                            <partial name="_Icon" model="@("message")" />
                            <span>@post.CommentCount</span>
                        </a>
                        <a class="aca-action aca-action--end aca-action--accent" asp-action="Details" asp-route-id="@post.Id">
                            Open discussion <partial name="_Icon" model="@("chevron-right")" />
                        </a>
                    </footer>
                </article>
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="aca-pagination" aria-label="Feed pagination">
                    @if (Model.HasPrevious)
                    {
                        <a class="aca-page" href="@($"{feedUrl}?page={Model.Page - 1}{batchQuery}")" rel="prev">
                            <partial name="_Icon" model="@("chevron-left")" /> Newer
                        </a>
                    }
                    else
                    {
                        <span class="aca-page aca-page--disabled"><partial name="_Icon" model="@("chevron-left")" /> Newer</span>
                    }
                    <span class="aca-page-count">Page @Model.Page of @Model.TotalPages</span>
                    @if (Model.HasNext)
                    {
                        <a class="aca-page" href="@($"{feedUrl}?page={Model.Page + 1}{batchQuery}")" rel="next">
                            Older <partial name="_Icon" model="@("chevron-right")" />
                        </a>
                    }
                    else
                    {
                        <span class="aca-page aca-page--disabled">Older <partial name="_Icon" model="@("chevron-right")" /></span>
                    }
                </nav>
            }
        }
    </div>

    <aside class="aca-rail" aria-label="Community information">
        <section class="aca-rail-card">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="aca-brand-mark" aria-hidden="true">ACA</span>
                <div>
                    <div class="fw-semibold aca-rail-brand">Akkupi CSE Alliance</div>
                    <div class="aca-faint aca-rail-brand-sub">Connecting generations</div>
                </div>
            </div>
            <p class="aca-rail-text">
                A private-feeling space for current students, graduates, and alumni of the Akkupi
                Computer Department — every batch, one community.
            </p>
        </section>

        <section class="aca-rail-card">
            <div class="aca-rail-title">Explore</div>
            <ul class="aca-rail-list">
                <li><a class="aca-rail-link" asp-controller="Batches" asp-action="Index"><partial name="_Icon" model="@("layers")" /> Browse batches</a></li>
                <li><a class="aca-rail-link" asp-controller="Members" asp-action="Index"><partial name="_Icon" model="@("users")" /> Find members</a></li>
                @if (isSignedIn)
                {
                    <li><a class="aca-rail-link" asp-controller="Profile" asp-action="Index"><partial name="_Icon" model="@("user")" /> My profile</a></li>
                }
                else
                {
                    <li><a class="aca-rail-link" asp-controller="Account" asp-action="Register"><partial name="_Icon" model="@("user")" /> Create an account</a></li>
                }
            </ul>
        </section>

        <section class="aca-rail-card">
            <div class="aca-rail-title">House rules</div>
            <ul class="aca-rail-text ps-3 mb-0 d-flex flex-column gap-1">
                <li>Be respectful to every batch and generation.</li>
                <li>No spam, harassment, or irrelevant advertising.</li>
                <li>Report content that breaks these rules.</li>
            </ul>
        </section>
    </aside>
</div>

@functions {
    private static string DisplayName(string? name)
    {
        var trimmed = (name ?? string.Empty).Trim();
        return trimmed.Length == 0 ? "Member" : trimmed;
    }

    private static string Initial(string? name)
    {
        var trimmed = (name ?? string.Empty).Trim();
        return trimmed.Length == 0 ? "?" : trimmed[..1].ToUpperInvariant();
    }

    private static string TimeAgo(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalSeconds < 60)
        {
            return "just now";
        }

        if (span.TotalMinutes < 60)
        {
            return $"{(int)span.TotalMinutes}m ago";
        }

        if (span.TotalHours < 24)
        {
            return $"{(int)span.TotalHours}h ago";
        }

        if (span.TotalDays < 7)
        {
            return $"{(int)span.TotalDays}d ago";
        }

        if (span.TotalDays < 30)
        {
            return $"{(int)(span.TotalDays / 7)}w ago";
        }

        return utc.ToLocalTime().ToString("MMM d, yyyy");
    }
}
