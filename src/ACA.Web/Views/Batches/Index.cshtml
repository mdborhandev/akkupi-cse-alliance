@model IReadOnlyList<BatchDto>
@{
    ViewData["Title"] = "Batches";
}

<div class="aca-page-head">
    <div>
        <span class="aca-eyebrow"><partial name="_Icon" model="@("layers")" /> Catalogue</span>
        <h1>Batches</h1>
        <p class="aca-page-sub">Every generation of the Akkupi Computer Department, in one place.</p>
    </div>
    <span class="aca-count-pill">@Model.Count</span>
</div>

@if (Model.Count == 0)
{
    <div class="aca-empty">
        <div class="aca-empty-icon"><partial name="_Icon" model="@("layers")" /></div>
        <p class="fw-semibold text-body mb-1">No batches yet</p>
        <p class="mb-0 small">An admin has not added any batches to the catalogue.</p>
    </div>
}
else
{
    <div class="aca-batch-grid">
        @foreach (var batch in Model)
        {
            <a class="aca-batch-card" asp-controller="Members" asp-action="Index" asp-route-batchId="@batch.Id">
                <span class="aca-batch-mark" aria-hidden="true">@batch.BatchNo.ToString("D2")</span>
                <span class="aca-batch-body">
                    <span class="aca-batch-name">@batch.Name</span>
                    <span class="aca-batch-session">Session @batch.Session</span>
                    <span class="aca-batch-members">
                        <partial name="_Icon" model="@("users")" />
                        @batch.MemberCount member@(batch.MemberCount == 1 ? "" : "s")
                    </span>
                </span>
                <span class="aca-member-chevron" aria-hidden="true"><partial name="_Icon" model="@("chevron-right")" /></span>
            </a>
        }
    </div>
}
