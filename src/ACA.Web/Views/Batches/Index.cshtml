@model IReadOnlyList<BatchDto>
@{
    ViewData["Title"] = "Batches";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h4 fw-semibold mb-1">Batches</h1>
        <p class="aca-muted mb-0 small">Every generation of the Akkupi Computer Department.</p>
    </div>
    <span class="aca-muted small">@Model.Count batch@(Model.Count == 1 ? "" : "es")</span>
</div>

@if (Model.Count == 0)
{
    <div class="aca-empty">
        <p class="fw-semibold mb-1">No batches yet</p>
        <p class="mb-0 small">An admin has not added any batches to the catalogue.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var batch in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h6 fw-semibold mb-0">@batch.Name</h2>
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis">Batch @batch.BatchNo</span>
                        </div>
                        <p class="small aca-muted mb-3">Session @batch.Session</p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="small">@batch.MemberCount member@(batch.MemberCount == 1 ? "" : "s")</span>
                            <a class="small text-decoration-none" asp-controller="Members" asp-action="Index" asp-route-batchId="@batch.Id">View members</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
