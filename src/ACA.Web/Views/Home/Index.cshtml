@{
    ViewData["Title"] = "Home";
}

<div class="aca-feed">
    <div class="p-4 p-md-5 mb-4 rounded-4 border bg-body-tertiary">
        <h1 class="h3 fw-semibold mb-2">Akkupi CSE Alliance</h1>
        <p class="text-body-secondary mb-3">Connecting Students, Alumni &amp; Generations.</p>
        <p class="mb-4">A private-feeling community for every batch of the Akkupi Computer Department — share updates, find people, stay connected.</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Join the community</a>
        <a class="btn btn-outline-secondary ms-2" asp-controller="Posts" asp-action="Index">Browse the feed</a>
    </div>
</div>
