@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var displayName = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Member" : User.Identity!.Name!;
    var nameSource = displayName.Contains('@') ? displayName.Split('@')[0] : displayName;
    var nameParts = nameSource.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
    var userInitials = nameParts.Length == 0 ? "?" : nameParts[0].Substring(0, 1).ToUpperInvariant();
    if (nameParts.Length > 1)
    {
        userInitials += nameParts[1].Substring(0, 1).ToUpperInvariant();
    }
}
@functions {
    private string CurrentController()
        => ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    private bool IsController(string controller)
        => string.Equals(CurrentController(), controller, StringComparison.OrdinalIgnoreCase);

    private string NavClass(string controller)
        => IsController(controller) ? "nav-link active" : "nav-link";

    private string AriaCurrent(string controller)
        => IsController(controller) ? "page" : "false";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ACA</title>
    <script>
        (function () {
            var saved = null;
            try { saved = localStorage.getItem('aca-theme'); } catch (e) { }
            if (!saved) { saved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
            document.documentElement.setAttribute('data-bs-theme', saved);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
<a class="aca-skip-link" href="#main-content">Skip to content</a>
<header>
    <nav class="navbar navbar-expand-lg border-bottom app-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">ACA</span>
                <span class="d-none d-sm-inline text-body-secondary fw-normal small ms-1">Akkupi CSE Alliance</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="@NavClass("Posts")" aria-current="@AriaCurrent("Posts")"
                           asp-controller="Posts" asp-action="Index">Feed</a>
                    </li>
                    <li class="nav-item">
                        <a class="@NavClass("Members")" aria-current="@AriaCurrent("Members")"
                           asp-controller="Members" asp-action="Index">Members</a>
                    </li>
                    <li class="nav-item">
                        <a class="@NavClass("Batches")" aria-current="@AriaCurrent("Batches")"
                           asp-controller="Batches" asp-action="Index">Batches</a>
                    </li>
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <button type="button" class="btn btn-sm btn-outline-secondary aca-theme-toggle" id="themeToggle"
                                title="Switch to dark theme" aria-label="Switch to dark color theme" aria-pressed="false">◐</button>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="@NavClass("Notifications") position-relative d-inline-flex align-items-center gap-1"
                               aria-current="@AriaCurrent("Notifications")"
                               asp-controller="Notifications" asp-action="Index">
                                Notifications
                                <span class="badge rounded-pill text-bg-danger position-absolute top-0 start-100 translate-middle d-none aca-notification-badge"
                                      id="notificationBadge" aria-hidden="true"
                                      data-endpoint="@(Url.Action("UnreadCount", "Notifications") ?? "/Notifications/UnreadCount")">0</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="aca-avatar aca-avatar-sm aca-avatar-initials flex-shrink-0" aria-hidden="true">@userInitials</span>
                                <span class="aca-nav-user-name" title="@displayName">@displayName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">My profile</a></li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                                {
                                    <li>
                                        <a class="dropdown-item @(IsController("Dashboard") ? "active" : string.Empty)"
                                           aria-current="@AriaCurrent("Dashboard")"
                                           asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link p-0 text-decoration-none">Log out</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="@NavClass("Account")" aria-current="@AriaCurrent("Account")"
                               asp-controller="Account" asp-action="Login">Log in</a>
                        </li>
                        <li class="nav-item"><a class="btn btn-sm btn-primary ms-lg-2" asp-controller="Account" asp-action="Register">Join</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main id="main-content" class="container py-4 flex-grow-1" tabindex="-1">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @RenderBody()
</main>

<footer class="app-footer border-top py-4 mt-auto">
    <div class="container d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 gap-sm-3 small">
        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-1 gap-sm-2">
            <span class="fw-semibold text-body">Akkupi CSE Alliance</span>
            <span class="aca-muted d-none d-sm-inline" aria-hidden="true">·</span>
            <span class="aca-muted">Connecting Students, Alumni &amp; Generations.</span>
        </div>
        <span class="aca-muted">© @DateTime.UtcNow.Year Akkupi CSE Alliance</span>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/theme.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
