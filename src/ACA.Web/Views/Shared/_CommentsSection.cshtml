@using ACA.Application.Interfaces
@model Guid
@inject ICommentService CommentService
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUserId = Guid.TryParse(UserManager.GetUserId(User), out var parsedUserId) ? (Guid?)parsedUserId : null;
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var comments = await CommentService.GetForPostAsync(Model, 1, 20, currentUserId);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var accountName = User.Identity?.Name ?? string.Empty;
    var accountSource = accountName.Contains('@') ? accountName.Split('@')[0] : accountName;
    var accountInitial = accountSource.Length == 0 ? "?" : accountSource[..1].ToUpperInvariant();
}

<section class="aca-comments" aria-labelledby="commentsHeading">
    <header class="aca-comments-head">
        <h2 class="aca-comments-title" id="commentsHeading">
            <partial name="_Icon" model="@("message")" /> Comments
        </h2>
        <span class="aca-count-pill">@comments.TotalCount</span>
    </header>

    @if (isSignedIn)
    {
        <form method="post" asp-controller="Comments" asp-action="Add" class="aca-comment-composer">
            <input type="hidden" name="postId" value="@Model" />
            <span class="aca-avatar aca-avatar-sm" aria-hidden="true">@accountInitial</span>
            <div class="flex-grow-1">
                <label class="visually-hidden" for="newComment-@Model">Write a comment</label>
                <textarea id="newComment-@Model" name="content" class="form-control" rows="1"
                          maxlength="2000" required placeholder="Write a comment…"></textarea>
            </div>
            <button type="submit" class="btn btn-sm btn-primary">Post</button>
        </form>
    }
    else
    {
        <p class="aca-comments-login">
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">Log in</a>
            to join the conversation.
        </p>
    }

    @if (comments.Items.Count == 0)
    {
        <div class="aca-empty aca-empty--compact">
            <div class="aca-empty-icon"><partial name="_Icon" model="@("message")" /></div>
            <p class="mb-0 small">No comments yet. Start the conversation.</p>
        </div>
    }
    else
    {
        <ul class="aca-thread">
            @foreach (var comment in comments.Items)
            {
                <li class="aca-comment">
                    @if (!string.IsNullOrWhiteSpace(comment.AuthorPhotoUrl))
                    {
                        <img src="@comment.AuthorPhotoUrl" alt="" class="aca-avatar aca-avatar-sm" loading="lazy" />
                    }
                    else
                    {
                        <span class="aca-avatar aca-avatar-sm" aria-hidden="true">@Initial(comment.AuthorName)</span>
                    }
                    <div class="aca-comment-body">
                        <div class="aca-comment-meta">
                            <span class="aca-comment-author">@comment.AuthorName</span>
                            <span class="aca-comment-time" title="@comment.CreatedAtUtc.ToString("u")">
                                @comment.CreatedAtUtc.ToLocalTime().ToString("g")
                            </span>
                        </div>
                        <p class="aca-comment-text">@comment.Content</p>

                        @if (isSignedIn)
                        {
                            <div class="aca-comment-actions">
                                <details class="aca-reply">
                                    <summary>
                                        <partial name="_Icon" model="@("message")" /> Reply
                                    </summary>
                                    <form method="post" asp-controller="Comments" asp-action="Add" class="aca-reply-form">
                                        <input type="hidden" name="postId" value="@Model" />
                                        <input type="hidden" name="parentCommentId" value="@comment.Id" />
                                        <label class="visually-hidden" for="reply-@comment.Id">Reply</label>
                                        <textarea id="reply-@comment.Id" name="content" class="form-control" rows="1"
                                                  maxlength="2000" required placeholder="Reply to @comment.AuthorName…"></textarea>
                                        <button type="submit" class="btn btn-sm btn-primary">Send</button>
                                    </form>
                                </details>
                                <a class="aca-comment-link" asp-controller="Reports" asp-action="Create"
                                   asp-route-commentId="@comment.Id">
                                    <partial name="_Icon" model="@("flag")" /> Report
                                </a>
                            </div>
                        }

                        @if (comment.Replies.Count > 0)
                        {
                            <ul class="aca-thread aca-thread--reply">
                                @foreach (var reply in comment.Replies)
                                {
                                    <li class="aca-comment aca-comment--reply">
                                        @if (!string.IsNullOrWhiteSpace(reply.AuthorPhotoUrl))
                                        {
                                            <img src="@reply.AuthorPhotoUrl" alt="" class="aca-avatar aca-avatar-xs" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="aca-avatar aca-avatar-xs" aria-hidden="true">@Initial(reply.AuthorName)</span>
                                        }
                                        <div class="aca-comment-body">
                                            <div class="aca-comment-meta">
                                                <span class="aca-comment-author">@reply.AuthorName</span>
                                                <span class="aca-comment-time" title="@reply.CreatedAtUtc.ToString("u")">
                                                    @reply.CreatedAtUtc.ToLocalTime().ToString("g")
                                                </span>
                                            </div>
                                            <p class="aca-comment-text">@reply.Content</p>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </li>
            }
        </ul>
        @if (comments.TotalCount > comments.Items.Count)
        {
            <p class="aca-comments-more">
                Showing the latest @comments.Items.Count of @comments.TotalCount comments.
            </p>
        }
    }
</section>

@functions {
    private static string Initial(string? name)
    {
        var trimmed = (name ?? string.Empty).Trim();
        return trimmed.Length == 0 ? "?" : trimmed[..1].ToUpperInvariant();
    }
}
