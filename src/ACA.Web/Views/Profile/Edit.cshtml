@model UpdateProfileDto
@{
    ViewData["Title"] = "Edit profile";
    var batches = ViewData["Batches"] as IReadOnlyList<BatchDto> ?? Array.Empty<BatchDto>();
    var currentPhotoUrl = ViewData["CurrentPhotoUrl"] as string;
}

<a class="aca-back" asp-action="Index">
    <partial name="_Icon" model="@("chevron-left")" /> Back to profile
</a>

<div class="aca-page-head">
    <div>
        <span class="aca-eyebrow"><partial name="_Icon" model="@("pen")" /> Profile</span>
        <h1>Edit profile</h1>
        <p class="aca-page-sub">Keep your batch and status up to date so batchmates can find you.</p>
    </div>
</div>

<div class="aca-edit-layout">
    <form asp-controller="Profile" asp-action="Edit" method="post" enctype="multipart/form-data" class="aca-compose-card">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="aca-photo-row">
            @if (!string.IsNullOrWhiteSpace(currentPhotoUrl))
            {
                <img src="@currentPhotoUrl" alt="Current profile photo" class="aca-avatar aca-avatar-lg" />
            }
            else
            {
                <span class="aca-avatar aca-avatar-lg" aria-hidden="true">—</span>
            }
            <div class="flex-grow-1">
                <label for="photo" class="form-label">Profile photo</label>
                <input id="photo" class="form-control" type="file" name="photo" accept="image/*" />
                <div class="form-text">JPG, PNG or WebP · max 5 MB.</div>
            </div>
        </div>

        <hr class="aca-rule" />

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Full name</label>
            <input asp-for="FullName" class="form-control" maxlength="120" autocomplete="name" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Bio" class="form-label">Bio</label>
            <textarea asp-for="Bio" class="form-control" rows="4" maxlength="600"
                      placeholder="A short introduction — your interests, work or favourite memories."></textarea>
            <div class="form-text">Up to 600 characters.</div>
            <span asp-validation-for="Bio" class="text-danger small"></span>
        </div>

        <div class="row g-3">
            <div class="col-12 col-sm-6">
                <label asp-for="BatchId" class="form-label">Batch</label>
                <select asp-for="BatchId" class="form-select">
                    <option value="">Not set</option>
                    @foreach (var batch in batches)
                    {
                        <option value="@batch.Id">Batch @batch.BatchNo — @batch.Name (@batch.Session)</option>
                    }
                </select>
                <span asp-validation-for="BatchId" class="text-danger small"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="MemberType" class="form-label">I am a</label>
                <select asp-for="MemberType" class="form-select">
                    <option value="CurrentStudent">Current student</option>
                    <option value="Alumni">Alumni</option>
                </select>
                <span asp-validation-for="MemberType" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="CurrentStatus" class="form-label">Current status <span class="aca-muted fw-normal">(optional)</span></label>
            <input asp-for="CurrentStatus" class="form-control" maxlength="120" placeholder="e.g. Software Engineer at Acme" />
            <span asp-validation-for="CurrentStatus" class="text-danger small"></span>
        </div>

        <div class="aca-compose-foot">
            <span class="aca-faint small">Your name and batch are visible to other members.</span>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </div>
    </form>
</div>
