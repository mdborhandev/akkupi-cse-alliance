@model MemberDetailDto
@{
    ViewData["Title"] = "My profile";

    var nameParts = (Model.FullName ?? string.Empty).Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = string.Empty;
    if (nameParts.Length > 0) initials += nameParts[0][0];
    if (nameParts.Length > 1) initials += nameParts[1][0];
    initials = initials.Length == 0 ? "?" : initials.ToUpperInvariant();
}

<div class="aca-page-head">
    <div>
        <span class="aca-eyebrow"><partial name="_Icon" model="@("user")" /> My account</span>
        <h1>Profile</h1>
        <p class="aca-page-sub">This is how other members see you in the community.</p>
    </div>
</div>

<section class="aca-profile">
    <div class="aca-profile-cover" aria-hidden="true"></div>
    <div class="aca-profile-head">
        @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoUrl))
        {
            <img src="@Model.ProfilePhotoUrl" alt="@Model.FullName" class="aca-avatar aca-avatar-lg" />
        }
        else
        {
            <span class="aca-avatar aca-avatar-lg" aria-hidden="true">@initials</span>
        }

        <div class="aca-profile-actions">
            <a class="btn btn-primary btn-sm" asp-action="Edit">
                <partial name="_Icon" model="@("pen")" /> Edit profile
            </a>
        </div>
    </div>

    <div class="aca-profile-body">
        <h1 class="aca-profile-name">@Model.FullName</h1>
        <div class="aca-profile-chips">
            <span class="aca-chip @(Model.MemberType == MemberType.Alumni ? "aca-chip--alumni" : "aca-chip--student")">@(Model.MemberType == MemberType.Alumni ? "Alumni" : "Current student")</span>
            @if (!string.IsNullOrWhiteSpace(Model.BatchName))
            {
                <span class="aca-chip">@Model.BatchName</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Session))
            {
                <span class="aca-chip">Session @Model.Session</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.CurrentStatus))
        {
            <p class="aca-profile-status">@Model.CurrentStatus</p>
        }

        <hr class="aca-rule" />

        <h2 class="aca-profile-section-title">About</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Bio))
        {
            <p class="aca-profile-bio">@Model.Bio</p>
        }
        else
        {
            <p class="aca-profile-bio aca-muted">No bio yet. <a asp-action="Edit">Add a short introduction</a> so batchmates know what you are up to.</p>
        }

        <div class="aca-profile-foot">
            <span>Member since @Model.JoinedAtUtc.ToLocalTime().ToString("MMMM yyyy")</span>
            <a class="text-reset" asp-controller="Members" asp-action="Details" asp-route-id="@Model.UserId">View public profile →</a>
        </div>
    </div>
</section>
