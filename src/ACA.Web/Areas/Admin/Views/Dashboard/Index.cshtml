@{
    ViewData["Title"] = "Dashboard";
    var memberCount = (int)ViewBag.MemberCount;
    var pendingApprovalCount = (int)ViewBag.PendingApprovalCount;
    var postCount = (int)ViewBag.PostCount;
    var pendingReportCount = (int)ViewBag.PendingReportCount;
}
<div class="mb-4">
    <h1 class="h4 mb-1">Dashboard</h1>
    <p class="aca-muted small mb-0">Community overview and moderation shortcuts.</p>
</div>

<div class="row g-3">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="small text-uppercase aca-muted fw-semibold">Members</div>
                <div class="display-6 fw-semibold">@memberCount</div>
                <a class="small mt-auto" asp-area="Admin" asp-controller="Members" asp-action="Index">Manage members →</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="small text-uppercase aca-muted fw-semibold">Pending approvals</div>
                    @if (pendingApprovalCount > 0)
                    {
                        <span class="badge text-bg-warning">Needs review</span>
                    }
                </div>
                <div class="display-6 fw-semibold">@pendingApprovalCount</div>
                <a class="small mt-auto" asp-area="Admin" asp-controller="Members" asp-action="Index">Review members →</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="small text-uppercase aca-muted fw-semibold">Posts</div>
                <div class="display-6 fw-semibold">@postCount</div>
                <a class="small mt-auto" asp-area="" asp-controller="Posts" asp-action="Index">View feed →</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="small text-uppercase aca-muted fw-semibold">Pending reports</div>
                    @if (pendingReportCount > 0)
                    {
                        <span class="badge text-bg-danger">Open</span>
                    }
                </div>
                <div class="display-6 fw-semibold">@pendingReportCount</div>
                <a class="small mt-auto" asp-area="Admin" asp-controller="Reports" asp-action="Index">Moderate reports →</a>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h2 class="h6 mb-3">Quick links</h2>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-sm btn-outline-secondary" asp-area="Admin" asp-controller="Members" asp-action="Index">Members</a>
            <a class="btn btn-sm btn-outline-secondary" asp-area="Admin" asp-controller="Batches" asp-action="Index">Batches</a>
            <a class="btn btn-sm btn-outline-secondary" asp-area="Admin" asp-controller="Reports" asp-action="Index">Reports</a>
            <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Home" asp-action="Index">Back to site</a>
        </div>
    </div>
</div>
